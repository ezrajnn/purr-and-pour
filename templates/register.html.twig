{% extends 'base.html.twig' %}

{% block title %}Register | Purr & Pour Café{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('register.css') }}">
    <link rel="stylesheet" href="{{ asset('loginHeader.css') }}">
    <link rel="stylesheet" href="{{ asset('style.css') }}">
{% endblock %}

{% block body %}
    {% include 'navigation/header.html.twig' %}

    <main class="register-wrapper">
        <div class="register-container">
            <h1>Register</h1>

            <p class="register-subtitle">
                Join Purr & Pour! Create your account to get started.
            </p>

            <form action="{{ path('login') }}" method="GET">
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" name="name" placeholder="Full name" required>
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" placeholder="example@email.com" required>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" required>
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" name="confirm_password" required>
                </div>

                <button type="submit" class="register-btn">
                    Register
                </button>
            </form>

            <p class="login-text">
                Already have an account?
                <a href="{{ path('login') }}">Log in</a>
            </p>
        </div>
    </main>

    {% include 'navigation/footer.html.twig' %}
{% endblock %}
