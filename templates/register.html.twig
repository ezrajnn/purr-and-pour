{% extends 'base.html.twig' %}

{% block title %}Register | Purr & Pour Café{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('register.css') }}">
    <link rel="stylesheet" href="{{ asset('loginHeader.css') }}">
    <link rel="stylesheet" href="{{ asset('style.css') }}">
{% endblock %}

{% block body %}
    {% include 'navigation/header.html.twig' %}

    <main class="register-wrapper">
        <div class="register-container">
            <h1>Register</h1>

            <p class="register-subtitle">
                Join Purr & Pour! Create your account to get started.
            </p>

            {% if error is defined and error %}
                <p class="message" style="color: #b91c1c; background: #fee2e2; padding: 10px; border-radius: 6px; font-size: 14px; margin-bottom: 15px; text-align: center;">
                    {{ error }}
                </p>
            {% endif %}

            <form action="{{ path('register') }}" method="POST">
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" name="name" value="{{ name|default('') }}" placeholder="Full name" required>
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" value="{{ email|default('') }}" placeholder="example@email.com" required>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" required>
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" name="confirm_password" required>
                </div>

                <button type="submit" class="register-btn">
                    Register
                </button>
            </form>

            <p class="login-text">
                Already have an account?
                <a href="{{ path('login') }}">Log in</a>
            </p>
        </div>
    </main>

    {% include 'navigation/footer.html.twig' %}
{% endblock %}
