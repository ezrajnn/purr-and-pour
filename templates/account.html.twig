{% extends 'base.html.twig' %}

{% block title %}My Account & Transaction History | Purr & Pour Café{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('loginHeader.css') }}">
    <link rel="stylesheet" href="{{ asset('account.css') }}">
    <link rel="stylesheet" href="{{ asset('style.css') }}">
{% endblock %}

{% block body %}
    {% include 'navigation/header.html.twig' %}

    <main class="account-page">
        <!-- User Profile Header -->
        <div class="profile-card">
            <div class="profile-details">
                <div class="profile-avatar">
                    {{ (user.name|default(app.session.get('name', 'Member'))|slice(0, 1))|upper }}
                </div>
                <div class="profile-info">
                    <h1>{{ user.name|default(app.session.get('name')) }}</h1>
                    <p>{{ user.email|default(app.session.get('email')) }}</p>
                    <div>
                        <span class="role-badge">
                            {% if (user.role|default(app.session.get('role'))) == 'admin' %}
                                ⚙ Administrator
                            {% else %}
                                🐾 Café Member
                            {% endif %}
                        </span>
                    </div>
                </div>
            </div>

            <div class="profile-actions">
                {% if (user.role|default(app.session.get('role'))) == 'admin' %}
                    <a href="{{ path('admin_dashboard') }}" class="btn-order-now" style="background-color: #8c6d48;">⚙ Admin Dashboard</a>
                {% endif %}
                <a href="{{ path('menu') }}" class="btn-order-now">Order Now →</a>
                <a href="{{ path('logout') }}" class="btn-order-now" style="background-color: #a89f91;">Log Out</a>
            </div>
        </div>

        <!-- Order Statistics / Quick Metrics -->
        <div class="stats-grid">
            <div class="stat-card">
                <span>Total Orders</span>
                <h3>{{ total_orders|default(0) }}</h3>
            </div>
            <div class="stat-card">
                <span>Lifetime Spent</span>
                <h3>${{ total_spent|default(0.00)|number_format(2) }}</h3>
            </div>
            <div class="stat-card">
                <span>Pending Orders</span>
                <h3>{{ pending_count|default(0) }}</h3>
            </div>
            <div class="stat-card">
                <span>Approved & Ready</span>
                <h3>{{ approved_count|default(0) }}</h3>
            </div>
        </div>

        <!-- Orders Section -->
        <section class="orders-section">
            <div class="orders-header">
                <h2>☕ Transaction & Order History</h2>
                
                <div class="status-filters">
                    <button type="button" class="filter-btn active" onclick="filterOrders('all', this)">All Orders ({{ total_orders|default(0) }})</button>
                    <button type="button" class="filter-btn" onclick="filterOrders('Pending', this)">Pending ({{ pending_count|default(0) }})</button>
                    <button type="button" class="filter-btn" onclick="filterOrders('Approved', this)">Approved ({{ approved_count|default(0) }})</button>
                    <button type="button" class="filter-btn" onclick="filterOrders('Completed', this)">Completed</button>
                </div>
            </div>

            <div style="overflow-x: auto;">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Date & Time</th>
                            <th>Items Summary</th>
                            <th>Payment Method</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="orders-tbody">
                        {% if orders is empty %}
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 30px; color: #8c7b6d;">
                                    No transaction history found yet. Visit our menu to place an order!
                                </td>
                            </tr>
                        {% else %}
                            {% for ord in orders %}
                                <tr data-status="{{ ord.status }}">
                                    <td><strong style="color: #634832;">#{{ '%05d'|format(ord.id) }}</strong></td>
                                    <td>{{ ord.createdAt|date("M d, Y h:i A") }}</td>
                                    <td>{{ ord.itemsSummary|default('Order items') }}</td>
                                    <td>
                                        {{ ord.paymentMethod }}
                                        {% if ord.referenceNumber %}
                                            <div style="font-size: 11px; color: #8c7b6d;">Ref: {{ ord.referenceNumber }}</div>
                                        {% endif %}
                                    </td>
                                    <td><strong>${{ ord.totalAmount|number_format(2) }}</strong></td>
                                    <td>
                                        <span class="status-pill status-{{ ord.status|lower }}">
                                            <span class="status-dot"></span>
                                            {{ ord.status }}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="{{ path('order_confirmation', {'id': ord.id}) }}" class="receipt-link-btn">View Receipt</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <script>
        function filterOrders(status, button) {
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');

            const rows = document.querySelectorAll('#orders-tbody tr');
            rows.forEach(row => {
                if (status === 'all' || row.getAttribute('data-status') === status) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>

    {% include 'navigation/footer.html.twig' %}
{% endblock %}
