{% extends 'base.html.twig' %}

{% block title %}Order Confirmed | Purr & Pour Café{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('loginHeader.css') }}">
    <link rel="stylesheet" href="{{ asset('checkout.css') }}">
    <link rel="stylesheet" href="{{ asset('orderConfirmation.css') }}">
    <link rel="stylesheet" href="{{ asset('style.css') }}">
{% endblock %}

{% block body %}
    {% include 'navigation/header.html.twig' %}

    <main class="checkout-page">
        <div class="checkout-container receipt-container">
            <div class="receipt-card">
                <div class="receipt-header">
                    <div class="success-badge">✓</div>
                    <h1>Order Confirmed!</h1>
                    <p class="receipt-subtitle">Thank you for your order, <strong>{{ order.customerName|default(app.session.get('name')) }}</strong>! We are preparing your café favorites.</p>
                    <div class="order-number-pill">Order #{{ order ? '%05d'|format(order.id) : '00108' }}</div>
                </div>

                <div class="order-status-banner status-pending">
                    <div class="order-status-title">
                        Order Status: {{ order.status|default('Pending Admin Approval') }}
                    </div>
                    <div class="order-status-desc">
                        Your order has been recorded and stocks have been reserved. The café admin will confirm your order shortly.
                    </div>
                </div>

                <div class="receipt-section">
                    <h2 class="section-title">Order Details</h2>
                    <div class="order-meta-grid">
                        <div class="meta-box">
                            <span class="meta-label">Order Number</span>
                            <span class="meta-value">#{{ order ? '%05d'|format(order.id) : '00108' }}</span>
                        </div>
                        <div class="meta-box">
                            <span class="meta-label">Date & Time</span>
                            <span class="meta-value">{{ order ? order.createdAt|date("M d, Y h:i A") : "now"|date("M d, Y h:i A") }}</span>
                        </div>
                        <div class="meta-box">
                            <span class="meta-label">Payment Method</span>
                            <span class="meta-value">{{ order.paymentMethod|default('Cash on Pickup') }}</span>
                        </div>
                        <div class="meta-box">
                            <span class="meta-label">Pickup Location</span>
                            <span class="meta-value">{{ order.address|default('Table 1, Cat Lounge') }}</span>
                        </div>
                    </div>
                </div>

                <div class="receipt-section">
                    <h2 class="section-title">Purchased Items</h2>
                    <div class="summary-items">
                        {% if order and order.orderItems %}
                            {% for item in order.orderItems %}
                                <div class="summary-item">
                                    <div class="item-img-wrapper">
                                        <img src="{{ asset('elements/' ~ (item.product ? item.product.image : 'drink_1.png')) }}" alt="{{ item.productName }}">
                                    </div>
                                    <div class="item-info">
                                        <h4>{{ item.productName }}</h4>
                                        <span class="item-qty-price">Qty: {{ item.quantity }} × ${{ item.price|number_format(2) }}</span>
                                    </div>
                                    <div class="item-total">
                                        ${{ item.subtotal|number_format(2) }}
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="summary-item">
                                <div class="item-info"><h4>No items</h4></div>
                            </div>
                        {% endif %}
                    </div>

                    <div class="summary-totals" style="margin-top: 15px;">
                        <div class="summary-row total-row">
                            <span>Total Paid / Due</span>
                            <span>${{ order ? order.totalAmount|number_format(2) : '0.00' }}</span>
                        </div>
                    </div>
                </div>

                <div class="receipt-actions" style="display: flex; gap: 15px; margin-top: 25px;">
                    <a href="{{ path('menu') }}" class="btn-secondary" style="flex: 1; text-align: center; text-decoration: none; padding: 12px; border-radius: 8px; border: 1px solid #7c5c43; color: #7c5c43;">Back to Menu</a>
                    <a href="{{ path('account') }}" class="btn-primary" style="flex: 1; text-align: center; text-decoration: none; padding: 12px; border-radius: 8px; background: #7c5c43; color: white;">View History</a>
                </div>
            </div>
        </div>
    </main>

    {% include 'navigation/footer.html.twig' %}
{% endblock %}
