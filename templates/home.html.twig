{% extends 'base.html.twig' %}

{% block title %}Purr & Pour Café{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('style.css') }}">
    <link rel="stylesheet" href="{{ asset('loginHeader.css') }}">
{% endblock %}

{% block body %}
    {% include 'navigation/header.html.twig' %}

    <!-- Hero section -->
    <section class="hero" id="home">
        <div class="hero-content">
            <b>
                New Brown Cloud<br>
                Frappuccino<br>
                Available Now!
            </b>
            <h2>
                with more cats coming soon
            </h2>
            <p>
                A creamy, dreamy frappuccino with rich brown sugar and a
                smooth coffee flavor, perfect for a sweet and refreshing
                treat. Plus, more adorable cats are coming soon!
            </p>

            <!-- Hero Buttons -->
            <div class="hero-buttons">
                <a href="{{ path('menu') }}" class="order-btn">
                    Order Now ⟶
                </a>
            </div>
        </div>

        <!-- Hero Images -->
        <div class="image">
            <img src="{{ asset('elements/coffee.png') }}" alt="Brown Cloud Frappuccino" class="frappe">
            <img src="{{ asset('elements/iring.png') }}" alt="Cats" class="cats">
            <img src="{{ asset('elements/iring2.png') }}" alt="Cats" class="iring2">
        </div>
    </section>

    <!-- Bestseller Section -->
    <section class="bestseller-section">
        <!-- Header -->
        <div class="bestseller-header">
            <h2>Our Bestsellers</h2>
            <a href="{{ path('menu') }}" class="fullmenu-btn">
                View Full Menu ⟶
            </a>
        </div>

        <!-- Cards -->
        <div class="bestseller-cards">
            <!-- DRINK 1 -->
            <div class="drink-card">
                <div class="drink-image">
                    <img src="{{ asset('elements/drink_1.png') }}" alt="Chocolate Frappe">
                </div>
                <a href="{{ path('menu') }}" class="drink-info">
                    <h3>Latte Coffee</h3>
                </a>
            </div>

            <!-- Drink 2 -->
            <div class="drink-card">
                <div class="drink-image">
                    <img src="{{ asset('elements/drink_2.png') }}" alt="Milk Tea">
                </div>
                <a href="{{ path('menu') }}" class="drink-info">
                    <h3>Hot Americano</h3>
                </a>
            </div>

            <!-- Drink 3 -->
            <div class="drink-card">
                <div class="drink-image">
                    <img src="{{ asset('elements/drink_3.png') }}" alt="Caramel Macchiato">
                </div>
                <a href="{{ path('menu') }}" class="drink-info">
                    <h3>Espresso Coffee</h3>
                </a>
            </div>

            <!-- Drink 4 -->
            <div class="drink-card">
                <div class="drink-image">
                    <img src="{{ asset('elements/drink_4.png') }}" alt="Hot Mocha">
                </div>
                <a href="{{ path('menu') }}" class="drink-info">
                    <h3>Hot Mocha</h3>
                </a>
            </div>
        </div>
    </section>

    <!-- Cat Lounge -->
    <section class="lounge-section" id="cat-lounge">
        <div class="lounge-content">
            <h2>Our Cat Lounge</h2>
            <div class="lounge-line"></div>
            <p>
                A cozy space where you can relax, play, and spend quality
                time with our friendly cats. Take a break from the day,
                make new furry friends, and enjoy the comforting company
                of our playful companions.
            </p>
            <a href="{{ path('cat_lounge') }}" class="lounge-btn">
                View More ⟶
            </a>
        </div>

        <!-- Lounge Image -->
        <div class="lounge-image">
            <img src="{{ asset('elements/cat_lounge.png') }}" alt="Our Cat Lounge">
        </div>
    </section>

    <!-- Cat Profiles -->
    <section class="cat-profile-section" id="cats">
        <!-- Cat Profiles Header -->
        <div class="cat-profile-header">
            <h2>Cat Profile</h2>
            <div class="cat-profile-line"></div>
            <p>
                Meet the adorable cats of Purr & Pour! Get to know
                their names and sweet little faces.
            </p>
        </div>

        <!-- Cat Polaroids -->
        <div class="cat-profile-grid">
            <!-- Oliver -->
            <div class="cat-profile-card">
                <div class="cat-photo">
                    <img src="{{ asset('elements/oliver.png') }}" alt="Oliver">
                </div>
                <div class="cat-name">
                    <img src="{{ asset('elements/paw.png') }}" alt="Paw" class="paw-image">
                    <h3>Oliver</h3>
                </div>
            </div>

            <!-- Becka -->
            <div class="cat-profile-card">
                <div class="cat-photo">
                    <img src="{{ asset('elements/becka.png') }}" alt="Becka">
                </div>
                <div class="cat-name">
                    <img src="{{ asset('elements/paw.png') }}" alt="Paw" class="paw-image">
                    <h3>Becka</h3>
                </div>
            </div>

            <!-- Billy -->
            <div class="cat-profile-card">
                <div class="cat-photo">
                    <img src="{{ asset('elements/billy.png') }}" alt="Billy">
                </div>
                <div class="cat-name">
                    <img src="{{ asset('elements/paw.png') }}" alt="Paw" class="paw-image">
                    <h3>Billy</h3>
                </div>
            </div>

            <!-- Percy -->
            <div class="cat-profile-card">
                <div class="cat-photo">
                    <img src="{{ asset('elements/percy.png') }}" alt="Percy">
                </div>
                <div class="cat-name">
                    <img src="{{ asset('elements/paw.png') }}" alt="Paw" class="paw-image">
                    <h3>Percy</h3>
                </div>
            </div>

            <!-- Cassy -->
            <div class="cat-profile-card">
                <div class="cat-photo">
                    <img src="{{ asset('elements/cassy.png') }}" alt="Cassy">
                </div>
                <div class="cat-name">
                    <img src="{{ asset('elements/paw.png') }}" alt="Paw" class="paw-image">
                    <h3>Cassy</h3>
                </div>
            </div>

            <!-- Tom -->
            <div class="cat-profile-card">
                <div class="cat-photo">
                    <img src="{{ asset('elements/tom.png') }}" alt="Tom">
                </div>
                <div class="cat-name">
                    <img src="{{ asset('elements/paw.png') }}" alt="Paw" class="paw-image">
                    <h3>Tom</h3>
                </div>
            </div>

            <!-- Kimmy -->
            <div class="cat-profile-card">
                <div class="cat-photo">
                    <img src="{{ asset('elements/kimmy.png') }}" alt="Kimmy">
                </div>
                <div class="cat-name">
                    <img src="{{ asset('elements/paw.png') }}" alt="Paw" class="paw-image">
                    <h3>Kimmy</h3>
                </div>
            </div>

            <!-- Weasley -->
            <div class="cat-profile-card">
                <div class="cat-photo">
                    <img src="{{ asset('elements/weasley.png') }}" alt="Weasley">
                </div>
                <div class="cat-name">
                    <img src="{{ asset('elements/paw.png') }}" alt="Paw" class="paw-image">
                    <h3>Weasley</h3>
                </div>
            </div>
        </div>
    </section>

    <!-- Reviews -->
    <section class="reviews-section">
        <div class="reviews-container">
            <header class="reviews-header">
                <h2>Customer Reviews</h2>
            </header>

            <div class="reviews-grid">
                <!-- Review 1 -->
                <article class="review-card">
                    <div class="card-content">
                        <div class="card-top">
                            <span class="quote-mark">“</span>
                            <div class="rating-stars">★★★★★</div>
                        </div>
                        <p class="review-text">
                            Such a cozy and welcoming place! The cats are super sweet,
                            the ambiance is relaxing, and the pastries are absolutely delicious.
                        </p>
                    </div>
                    <div class="reviewer-info">
                        <img src="{{ asset('elements/gordon.png') }}" alt="Gordon" class="reviewer-avatar">
                        <span class="reviewer-name">Gordon</span>
                    </div>
                </article>

                <!-- Review 2 -->
                <article class="review-card">
                    <div class="card-content">
                        <div class="card-top">
                            <span class="quote-mark">“</span>
                            <div class="rating-stars">★★★★★</div>
                        </div>
                        <p class="review-text">
                            I had such a fun experience! The coffee was delicious,
                            the staff were friendly, and the cats made my visit even better.
                        </p>
                    </div>
                    <div class="reviewer-info">
                        <img src="{{ asset('elements/michael.png') }}" alt="Michael" class="reviewer-avatar">
                        <span class="reviewer-name">Michael</span>
                    </div>
                </article>

                <!-- Review 3 -->
                <article class="review-card">
                    <div class="card-content">
                        <div class="card-top">
                            <span class="quote-mark">“</span>
                            <div class="rating-stars">★★★★★</div>
                        </div>
                        <p class="review-text">
                            I really enjoyed my time here. The peaceful atmosphere,
                            tasty drinks, and lovely cats made the experience so memorable.
                        </p>
                    </div>
                    <div class="reviewer-info">
                        <img src="{{ asset('elements/joseph.png') }}" alt="Joseph" class="reviewer-avatar">
                        <span class="reviewer-name">Joseph</span>
                    </div>
                </article>
            </div>
        </div>
    </section>

    {% include 'navigation/footer.html.twig' %}
{% endblock %}
