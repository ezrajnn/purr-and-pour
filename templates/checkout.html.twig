{% extends 'base.html.twig' %}

{% block title %}Checkout | Purr & Pour Café{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('loginHeader.css') }}">
    <link rel="stylesheet" href="{{ asset('checkout.css') }}">
    <link rel="stylesheet" href="{{ asset('style.css') }}">
{% endblock %}

{% block body %}
    {% include 'navigation/header.html.twig' %}

    <main class="checkout-page">
        <div class="checkout-container">
            <div class="checkout-header">
                <h1>Complete Your Order</h1>
                <p>Review your items and enter details for pickup / payment.</p>
                <a href="{{ path('cart') }}">← Return to Cart</a>
            </div>

            <div class="checkout-grid">
                <!-- Left Column: Forms -->
                <div class="checkout-form-section">
                    <form action="{{ path('order_place') }}" method="POST">
                        <div class="form-card">
                            <h2 class="section-title">Customer Information</h2>
                            
                            <div class="form-group">
                                <label for="customer_name">Full Name *</label>
                                <input type="text" id="customer_name" name="customer_name" value="{{ app.session.get('name') }}" required>
                            </div>

                            <div class="form-group">
                                <label for="customer_email">Email Address</label>
                                <input type="email" id="customer_email" name="customer_email" value="{{ app.session.get('email') }}" placeholder="your@email.com">
                            </div>

                            <div class="form-group">
                                <label for="address">Pickup / Delivery Address *</label>
                                <input type="text" id="address" name="address" value="" placeholder="Enter your delivery address or table / pickup instructions" required>
                            </div>
                        </div>

                        <div class="form-card">
                            <h2 class="section-title">Payment Method</h2>
                            <div class="payment-options">
                                <label class="payment-option">
                                    <input type="radio" name="payment_method" value="Cash on Pickup" checked onclick="document.getElementById('gcash-reference-group').style.display='none'">
                                    <span class="payment-label">
                                        <strong>Cash on Pickup</strong>
                                        <small>Pay with cash upon claiming</small>
                                    </span>
                                </label>

                                <label class="payment-option">
                                    <input type="radio" name="payment_method" value="GCash" id="pm_gcash" onclick="document.getElementById('gcash-reference-group').style.display='block'">
                                    <span class="payment-label">
                                        <strong>GCash (Mobile Wallet)</strong>
                                        <small>Send payment via GCash and enter your transaction reference number</small>
                                    </span>
                                </label>
                            </div>

                            <!-- GCash Reference Number Field (shown when GCash is selected) -->
                            <div id="gcash-reference-group" class="form-group" style="margin-top: 18px; padding: 14px; background: #faf7f2; border: 1.5px dashed #c9baa9; border-radius: 10px; display: none;">
                                <label for="reference_number" style="display: flex; align-items: center; justify-content: space-between;">
                                    <span>GCash Reference Number *</span>
                                </label>
                                <input type="text" id="reference_number" name="reference_number" placeholder="12-digit reference number (e.g. 100298451234)" maxlength="12" style="background: #ffffff;">
                                <small style="color: #6e5c4e; font-size: 12px; margin-top: 6px; display: block;">
                                    Café GCash: <strong>0967 6767 6767</strong> (Purr & Pour Café). Must be exactly 12 numeric digits from your GCash receipt.
                                </small>
                            </div>
                        </div>

                        <button type="submit" class="btn-place-order">Place Order • ${{ total_amount|number_format(2) }}</button>
                    </form>
                </div>

                <!-- Right Column: Order Summary -->
                <div class="checkout-summary-section">
                    <div class="summary-card">
                        <h2 class="section-title">Order Summary ({{ total_items }} items)</h2>
                        
                        <div class="summary-items">
                            {% for item in cart_items %}
                                <div class="summary-item">
                                    <div class="item-img-wrapper">
                                        <img src="{{ asset('elements/' ~ item.product.image) }}" alt="{{ item.product.name }}">
                                    </div>
                                    <div class="item-info">
                                        <h4>{{ item.product.name }}</h4>
                                        <span class="item-qty-price">Qty: {{ item.quantity }} × ${{ item.product.price|number_format(2) }}</span>
                                    </div>
                                    <div class="item-total">
                                        ${{ (item.product.price * item.quantity)|number_format(2) }}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="summary-totals">
                            <div class="summary-row">
                                <span>Subtotal</span>
                                <span>${{ total_amount|number_format(2) }}</span>
                            </div>
                            <div class="summary-row">
                                <span>Pickup Fee</span>
                                <span>$0.00</span>
                            </div>
                            <div class="summary-row total-row">
                                <span>Grand Total</span>
                                <span>${{ total_amount|number_format(2) }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    {% include 'navigation/footer.html.twig' %}
{% endblock %}
