{% extends 'base.html.twig' %}

{% block title %}Menu | Purr & Pour Café{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('menu.css') }}">
    <link rel="stylesheet" href="{{ asset('loginHeader.css') }}">
    <link rel="stylesheet" href="{{ asset('style.css') }}">
{% endblock %}

{% block body %}
    {% include 'navigation/header.html.twig' %}

    <main class="menu-page">
        {% for category_name, items in categories %}
            <div class="menu-category-section">
                <h2 class="category-heading">
                    {{ category_name }}
                </h2>

                <div class="menu-container">
                    {% for product in items %}
                        <div class="menu-card">
                            <img src="{{ asset('elements/' ~ product.image) }}" alt="{{ product.name }}">

                            <div class="menu-info">
                                <div class="menu-title-row">
                                    <h3>{{ product.name }}</h3>
                                    <span>${{ product.price|number_format(2) }}</span>
                                </div>

                                <p class="{{ product.stock > 0 ? 'menu-stock-available' : 'menu-stock-out' }}">
                                    {% if product.stock > 0 %}
                                        Available Stock: {{ product.stock }}
                                    {% else %}
                                        Out of Stock
                                    {% endif %}
                                </p>
                            </div>

                            {% if app.session.get('role') == 'admin' %}
                                <a href="{{ path('admin_dashboard', {'edit': product.id}) }}" class="add-cart admin-edit-btn">⚙ Edit in Admin</a>
                            {% elseif product.stock > 0 %}
                                <form action="{{ path('cart_add') }}" method="POST">
                                    <input type="hidden" name="product_id" value="{{ product.id }}">
                                    <input type="hidden" name="quantity" value="1">
                                    <button type="submit" class="add-cart">
                                        Add to Cart
                                    </button>
                                </form>
                            {% else %}
                                <button type="button" class="add-cart sold-out-btn" disabled style="opacity: 0.5; cursor: not-allowed; background: #9ca3af;">
                                    Sold Out
                                </button>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </main>

    {% include 'navigation/footer.html.twig' %}
{% endblock %}